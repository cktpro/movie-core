{
    "name": "hacoidev/ophim-core",
    "description": "Ophim's core features",
    "type": "library",
    "authors": [
        {
            "name": "hacoidev",
            "email": "hacoi.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "ckfinder/ckfinder-laravel-package": "^5.0.2",
        "backpack/crud": "^7.1",
        "backpack/settings": "^3.2",
        "backpack/permissionmanager": "^7.3",
        "spatie/laravel-sitemap": "^7.4",
        "artesaos/seotools": "^1.4"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ophim\\Core\\": "src/",
            "Ophim\\Core\\Database\\Factories\\": "database/factories/",
            "Ophim\\Core\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ophim\\Core\\OphimServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
