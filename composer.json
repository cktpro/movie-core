{
    "name": "roxone/movie-core",
    "description": "Movie CMS core features",
    "type": "library",
    "authors": [
        {
            "name": "hacoidev",
            "email": "hacoi.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "ckfinder/ckfinder-laravel-package": "^5.0.2",
        "backpack/crud": "^6.7|^7.1",
        "backpack/settings": "^3.2",
        "backpack/permissionmanager": "^7.3",
        "spatie/laravel-sitemap": "^6.4|^7.4",
        "artesaos/seotools": "^1.4"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Movie\\Core\\": "src/",
            "Movie\\Core\\Database\\Factories\\": "database/factories/",
            "Movie\\Core\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Movie\\Core\\MovieServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
